# Riot Games API key - generate at https://developer.riotgames.com/
# For DEVELOPMENT: dev key (expires after 24h). For production (climbcheck.dolien.pl):
# production key from an approved application - see infra/DEPLOYMENT.md
RIOT_API_KEY=

# Postgres connection (must match infra/docker-compose.yml)
DATABASE_URL=jdbc:postgresql://localhost:5432/lp_leaderboard
DATABASE_USERNAME=lp_user
DATABASE_PASSWORD=lp_password

# Production domain (Caddy issues Let's Encrypt automatically) - prod only
DOMAIN=climbcheck.dolien.pl
