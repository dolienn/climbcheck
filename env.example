# Riot Games API key - generate at https://developer.riotgames.com/
# For DEVELOPMENT: dev key (expires after 24h). For production (climbcheck.com):
# production key from an approved application - see docs/DEPLOYMENT.md
RIOT_API_KEY=

# Postgres connection (must match docker-compose.yml)
DATABASE_URL=jdbc:postgresql://localhost:5432/lp_leaderboard
DATABASE_USERNAME=lp_user
DATABASE_PASSWORD=lp_password

# Production domains (Caddy issues Let's Encrypt automatically) - prod only.
# DOMAIN = the ClimbCheck app, PORTFOLIO_DOMAIN = the static portfolio landing.
DOMAIN=climbcheck.dolien.pl
PORTFOLIO_DOMAIN=dolien.pl
