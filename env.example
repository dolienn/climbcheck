# Riot Games API key - wygeneruj na https://developer.riotgames.com/
# Do DEVELOPMENTU: dev key (wygasa po 24h). Do produkcji (climbcheck.com):
# klucz produkcyjny z zatwierdzonej aplikacji — patrz docs/DEPLOYMENT.md
RIOT_API_KEY=

# Postgres connection (musi pasowac do docker-compose.yml)
DATABASE_URL=jdbc:postgresql://localhost:5432/lp_leaderboard
DATABASE_USERNAME=lp_user
DATABASE_PASSWORD=lp_password

# Domena dla produkcji (Caddy wystawia Let's Encrypt automatycznie) - tylko prod
DOMAIN=climbcheck.com
