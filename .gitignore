frontend/node_modules/
node_modules/
frontend/dist/
dist/
frontend/references/

# Env
.env
.env.*
!.env.example
!.env.*.example

# Logs
*.log
npm-debug.log*

# IDE
.idea/
.vscode/
*.iml

# Uploads
backend/uploads/*
!backend/uploads/.gitkeep
backend/uploads/projects/*
!backend/uploads/projects/.gitkeep

# Docs
FAZA*.md
FAZY.md

